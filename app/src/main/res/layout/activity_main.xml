<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#12121E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ATHER NAV"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#00D4FF"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Google Maps → Bluetooth Dashboard Mirror"
            android:textSize="13sp"
            android:textColor="#8888AA"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Dashboard Display Preview Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DASHBOARD DISPLAY PREVIEW"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00D4FF"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDashboard"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="---"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#00FF88"
                android:gravity="center"
                android:background="#0A0A10"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: STOPPED"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Service Controls -->
        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="START SERVICE"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnStopService"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="STOP SERVICE"
            android:backgroundTint="#333344"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnSwitchMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SWITCH MODE (TEST)"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <!-- Required Setup & Permissions Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVICE COMPATIBILITY SETUP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8888AA"
            android:layout_marginBottom="10dp"/>

        <!-- Step 1: Notification Access Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. NOTIFICATION LISTENER ACCESS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHECKING..."
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRANT NOTIFICATION ACCESS"
                android:backgroundTint="#FF6B35"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnRestrictedSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALLOW RESTRICTED SETTINGS (ANDROID 13+)"
                android:backgroundTint="#4A4A6A"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* If Notification Access is greyed out: tap 'ALLOW RESTRICTED SETTINGS' above → tap 3 dots (⋮) at top right → Allow restricted settings."
                android:textSize="11sp"
                android:textColor="#777788"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Step 2: Runtime Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. PHONE PERMISSIONS (BLUETOOTH &amp; NOTIFICATIONS)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvRuntimePerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS: CHECKING..."
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnRuntimePerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRANT PERMISSIONS"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Step 3: Battery Optimization Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. BATTERY OPTIMIZATION (PREVENT BACKGROUND KILL)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvBatteryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BATTERY: CHECKING..."
                android:textSize="12sp"
                android:textColor="#FF6B35"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SET BATTERY TO UNRESTRICTED"
                android:backgroundTint="#D84315"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Strongly recommended for Xiaomi, Samsung, OnePlus, Vivo and Oppo phones so the navigation service keeps running smoothly with screen locked."
                android:textSize="11sp"
                android:textColor="#777788"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUICK START GUIDE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8888AA"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Grant notification access and phone permissions above.\n2. Connect your phone to your scooter or car Bluetooth.\n3. Tap 'START SERVICE'.\n4. Open Google Maps and begin navigation.\n5. Turn directions appear right on the vehicle dashboard!"
            android:textSize="12sp"
            android:textColor="#9999AA"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
